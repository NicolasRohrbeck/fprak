    "    n = n_i(I_ion, T_e)\n",
    "    n_err = n_i_err(n, I_ion, I_err, T_e, T_err)\n",
    "    print('n_i von \"{}\" = ({:.0f} +/- {:.0f})e+12 1/m^3'.format(kennlinie, n/1e12, n_err/1e12))"
   ]
