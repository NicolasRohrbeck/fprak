    "# Methode 2\n",
    "def T_e(Upl, Ufl):\n",
    "    return const.e/np.log(np.sqrt(np.exp(1)/(2*np.pi)*(40*const.m_p)/(const.m_e)))*(Upl-Ufl)/const.k\n",
    "\n",
    "def T_e_err(Upl_err, Ufl_err):\n",
    "    return abs(const.e/np.log(np.sqrt(np.exp(1)/(2*np.pi)*(40*const.m_p)/(const.m_e)))/const.k)*(Upl_err + Ufl_err)\n",
    "\n",
    "print(f\"Sind die Spannungs-Dictionaries in gleicher Reihenfolge? {Uplasma.keys()==Ufl.keys()}\")\n",
    "\n",
    "T_e_2 = {}\n",
    "for name, (Up, Up_err), (Uf, Uf_err) in zip(Uplasma.keys(), Uplasma.values(), Ufl.values()):\n",
    "    T = T_e(Up, Uf)\n",
    "    T_err = T_e_err(Up_err, Uf_err)\n",
    "    T_e_2[name] = (T, T_err)\n",
    "\n",
    "for kennlinie, (Te, Te_err) in zip(T_e_2.keys(), T_e_2.values()):\n",
    "    print(f'Te von \"{kennlinie}\" = ({Te:4.0f} +/- {Te_err:3.0f}) K')"
   ]
