    "# Elektronendichte\n",
    "def n_e(I_e, T_e):\n",
    "    A = 8.9e-6 # Sondenfläche in qm\n",
    "    return 4*I_e/const.e/A*np.sqrt(np.pi*const.m_e/(8*const.k*T_e)) # - weg weil Vorzeichen von e? idk\n",
    "\n",
    "def n_e_err(n_e, I_e, I_e_err, T_e, T_e_err):\n",
    "    return abs(0.5/T_e*n_e)*T_e_err+abs(n_e/I_e)*I_e_err\n",
    "\n",
    "n_e_1 = {} # Elekteronendichte aus Elektronenetemperatur Methode 1\n",
    "n_e_2 = {}\n",
    "print(\"Für T_e aus Methode 1:\")\n",
    "for kennlinie, (T_e, T_e_err), (I_elek, I_err) in zip(Ufl.keys(), T_e_1.values(), I_e.values()):\n",
    "    I_elek *= 1e-6\n",
    "    I_err *= 1e-6\n",
    "    n = n_e(I_elek, T_e)\n",
    "    n_err = n_e_err(n, I_elek, I_err, T_e, T_e_err)\n",
    "    n_e_1[kennlinie] = (n, n_err)\n",
    "    print('n_e von \"{}\" = ({:.0f} +/- {:.0f})e+12 1/m^3'.format(kennlinie, n/1e12, n_err/1e12))\n",
    "\n",
    "print(\"\\nFür T_e aus Methode 2:\")\n",
    "for kennlinie, (T_e, T_err), (I_elek, I_err) in zip(Ufl.keys(), T_e_2.values(), I_e.values()):\n",
    "    I_elek *= 1e-6\n",
    "    I_err *= 1e-6\n",
    "    n = n_e(I_elek, T_e)\n",
    "    n_err = n_e_err(n, I_elek, I_err, T_e, T_err)\n",
    "    n_e_2[kennlinie] = (n, n_err)\n",
    "    print('n_e von \"{}\" = ({:.0f} +/- {:.0f})e+12 1/m^3'.format(kennlinie, n/1e12, n_err/1e12))"
   ]
