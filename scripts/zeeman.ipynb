    "abst = [abs(585.1892116881788-585.2114468568362)/2,\n",
    "       abs(585.1785599721572-585.2221702975352)/2,\n",
    "       abs(585.1679582518658-585.232785240565)/2,\n",
    "       abs(585.1634514046511-585.2377580199542)/2,\n",
    "       abs(585.1609681564712-585.239655705868)/2,\n",
    "       abs(585.1588880497595-585.2414266860361)/2] # spektrale Aufspaltung ist Abstand zu unverschobenen Linie\n",
    "\n",
    "# nur pi Komponente aus Torbens fits\n",
    "abstano2 = [abs(614.3041607701051-614.2965629685875)/2,\n",
    "            abs(614.3072227199356-614.2930292065272)/2,\n",
    "            abs(614.2902645840493-614.3100407064114)/2,\n",
    "            abs(614.2883263677575-614.3121610510948)/2,\n",
    "            abs(614.2865298788116-614.313396932627)/2,\n",
    "            abs(614.2850950457428-614.3150803159755)/2\n",
    "            ]\n",
    "\n",
    "import scipy.constants as const\n",
    "\n",
    "mags = [(06.1, 0.2),\n",
    "        (13.4, 0.4),\n",
    "        (19.5, 0.3),\n",
    "        (22.4, 0.6),\n",
    "        (24.1, 0.2),\n",
    "        (25.4, 0.4)]\n",
    "\n",
    "def spez_ladung(slope, line, j, jj):\n",
    "    return 4*np.pi*const.c*slope*(1e-9/(1e6/(4*np.pi)))/(line**2*const.mu_0)/(j-jj)\n",
    "\n",
    "def err_spez_ladung(em, slope, err_slope):\n",
    "    return abs(em/slope)*err_slope\n",
    "\n",
    "em = linregress([mag[0] for mag in mags], abst)\n",
    "print(em.slope, em.stderr)\n",
    "spez_em = spez_ladung(em.slope, 585.2e-9, 1.034, 0)\n",
    "print(f'{spez_em:e}({err_spez_ladung(spez_em, em.slope, em.stderr):e})')\n",
    "emx = np.arange(6.1, 26.4)\n",
    "\n",
    "fig, ax = plt.subplots()\n",
    "\n",
    "ax.plot(emx, em.intercept+emx*em.slope, 'b')\n",
    "ax.fill_between(emx, (em.intercept+em.intercept_stderr)+emx*(em.slope+em.stderr), (em.intercept-em.intercept_stderr)+emx*(em.slope-em.stderr))\n",
    "\n",
    "ax.errorbar([mag[0] for mag in mags], abst, yerr=0.002, xerr=[mag[1] for mag in mags], fmt='xk', capsize=2)\n",
    "\n",
    "ax.set_xlabel('Magnetfeld in kOe')\n",
    "ax.set_ylabel('Spektrale Aufspaltung in nm')\n",
    "\n",
    "ax.minorticks_on()\n",
    "ax.grid(which='major')\n",
    "ax.grid(which='minor', alpha=0.5)\n",
    "plt.show()\n",
    "\n",
    "\n",
